{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "node",
  "installCommand": "node --version",
  "buildCommand": "node --input-type=module -e \"await import('./services/soul-api/server.ts')\"",
  "functions": {
    "server.ts": { "maxDuration": 60, "supportsCancellation": true }
  }
}
